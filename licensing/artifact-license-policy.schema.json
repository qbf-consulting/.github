{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbfconsulting.digital/schemas/artifact-license-policy.schema.json",
  "title": "QBF Artifact License Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "default_license",
    "rules"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "default_license": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_classes",
          "license"
        ],
        "properties": {
          "artifact_classes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "license",
          "basis"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
